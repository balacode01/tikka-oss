# Copy this file to .env for local development, or set the same names in your hosting provider.
# Both values come from your Supabase project: Project Settings > API.

# The project URL, for example https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# The publishable (anon) key. Never put the service_role or secret key here.
VITE_SUPABASE_PUBLISHABLE_KEY=
